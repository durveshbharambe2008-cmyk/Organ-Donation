# ==============================================================================
# Git Ignore for Organ Donation Management System
# ==============================================================================

# Environment Variables & Secrets (CRITICAL: Never commit to public repo)
.env
.env.local
.env.*.local
*.env

# Python Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Logs & Temporary Files
*.log
*.tmp
